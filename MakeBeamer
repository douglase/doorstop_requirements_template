#via http://stackoverflow.com/a/11030209
# Converts doorstop-published HTML (dist/documents/*.html) into LaTeX Beamer
# slides (dist/*_beamer.tex) using pandoc.  The master beamer.tex in dist/
# \input{s} those generated files.
TXTDIR=dist
DOCDIR=dist/documents
HTMLS=$(wildcard $(DOCDIR)/*.html)
MDS=$(patsubst $(DOCDIR)/%.html,$(TXTDIR)/%_beamer.tex,$(HTMLS))

#$(patsubst pattern,replacement,text)
#Finds whitespace-separated words in text that match pattern and replaces them with replacement.

.PHONY : all

all : $(MDS)

$(TXTDIR)/%_beamer.tex : $(DOCDIR)/%.html
		pandoc -t beamer -f html+tex_math_dollars+tex_math_single_backslash $< -o $@
		#preserves math,see: http://stackoverflow.com/questions/11338049/how-to-convert-html-with-mathjax-into-latex-using-pandoc#11461355








